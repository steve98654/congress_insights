// Cloudflare Workers config for purple.nexus. Workers Builds runs `npm ci && npm run build` and then
// `npx wrangler deploy` from this folder (docs/hosting.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "purple-nexus",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Every other path is served straight from dist/ without running the Worker.
    "run_worker_first": ["/caucus/me", "/caucus/me/"]
  },
  // Turn off once purple.nexus is attached as a custom domain, or protect the workers.dev address with
  // Access too, so it is not a way around the sign-in (docs/auth.md).
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
