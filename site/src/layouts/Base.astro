---
import '../styles/global.css';
import { app, generated, formatDate, url } from '../lib/data';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Action items for every member of Congress toward Problem Solvers Caucus goals.' } = Astro.props;

const NAV = [
  ['', 'Overview'],
  ['members/', 'Members'],
  ['goals/', 'Goals'],
  ['insights/', 'Insights'],
  ['changes/', 'What changed'],
  ['outreach/', 'Outreach'],
];
const here = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const current = (path: string) => (path ? here.startsWith(`/caucus/${path}`) : /^\/caucus\/?$/.test(here));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="icon" href={url('favicon.ico')} sizes="48x48" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href={url()}>
          <img class="mark" src={url('logo-mark.svg')} alt="" width="24" height="24" />
          purple.nexus
          <span class="wordmark-sub">Caucus workspace</span>
        </a>
        <nav class="nav" aria-label="Sections">
          {
            NAV.map(([path, label]) => (
              <a href={app(path)} aria-current={current(path) ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        Built {formatDate(generated)} from congress-legislators, govinfo bill status and roll calls, Problem Solvers Caucus and No Labels
        releases, and 2026 election listings. Priorities rank options for each member; they are not predictions of what members will do.
      </div>
    </footer>
  </body>
</html>
